# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# In production (Vercel), set these in Project Settings → Environment Variables
# for BOTH the Production and Preview environments (this repo is public and
# every branch gets a live preview URL, so Preview needs real values too).

# --- Telegram Bot API ---
# Message @BotFather on Telegram, /newbot, and it gives you this token.
# Unlike WhatsApp's Meta tokens, this one never expires.
TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-botfather
# Chosen by you (not Telegram) — generate with `openssl rand -hex 32`, then
# register it with `npm run telegram:setup-webhook` (see README).
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram numeric user IDs allowed to log transactions.
# Message @userinfobot to find your own id.
ALLOWED_TG_USER_IDS=123456789

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
# Service role key — server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Gemini ---
# console.cloud.google.com/apis/credentials or aistudio.google.com/apikey
# Free tier — no billing account required. Check current rate limits at
# aistudio.google.com/rate-limit before relying on it for high volume.
GEMINI_API_KEY=your-gemini-api-key

# --- Price sources ---
# Optional fallback for US equities if the Yahoo adapter breaks
ALPHAVANTAGE_API_KEY=

# --- App secrets ---
# Random secret Vercel Cron sends as a Bearer token; generate with `openssl rand -hex 32`
CRON_SECRET=
# Password for the dashboard login screen
DASHBOARD_PASSWORD=
# Random secret used to sign the dashboard session cookie; generate with `openssl rand -hex 32`
SESSION_SECRET=
